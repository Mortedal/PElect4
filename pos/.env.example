# MongoDB connection string. For MongoDB Atlas (free cloud tier) it looks like:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pos

# Store name shown on the landing page
STORE_NAME=My Store

# Port the web app listens on
PORT=3000

# Time zone used to decide which "day" a sale belongs to
TIMEZONE=Asia/Manila

# How long a login lasts, in hours
SESSION_HOURS=12

# Set both to true when the app is served over https behind a proxy (e.g. Render, Railway)
SECURE_COOKIE=false
TRUST_PROXY=false
